// CRT (Curved)
//
// Delta Custom Filter, written in the Core Image Kernel Language:
// https://developer.apple.com/documentation/coreimage/writing-custom-kernels
//
// A filter file contains one kernel with this signature, which Delta runs once for each pixel on screen:
//
//     kernel vec4 name(sampler source, vec2 sourceSize, vec2 outputSize)
//
// * source:     The game screen at its native resolution, sampled with nearest-neighbor sampling.
// * sourceSize: Size of the game screen in pixels (e.g. 256 x 224 for SNES).
// * outputSize: Size of the screen on your device in pixels.
//
// Use destCoord() to get the position of the current pixel on your device (0...outputSize),
// and sample(source, samplerTransform(source, position)) to read the game screen at `position` (0...sourceSize).
// Coordinates are measured in pixels, with the origin in the bottom-left corner.

vec3 readColor(sampler source, vec2 position, vec2 sourceSize)
{
    return sample(source, samplerTransform(source, clamp(position, vec2(0.5), sourceSize - 0.5))).rgb;
}

float beam(float d, float brightness)
{
    float halfWidth = mix(0.48, 0.85, brightness);
    float t = clamp(abs(d) / halfWidth, 0.0, 1.0);
    float bump = 1.0 - t * t;
    return bump * bump;
}

float scanlines(float y, float pixelHeight, float brightness)
{
    float total = 0.0;
    total += beam(fract(y - pixelHeight / 3.0) - 0.5, brightness);
    total += beam(fract(y) - 0.5, brightness);
    total += beam(fract(y + pixelHeight / 3.0) - 0.5, brightness);
    return total / 3.0;
}

kernel vec4 crtCurved(sampler source, vec2 sourceSize, vec2 outputSize)
{
    // Curved glass: each axis bows outward more the farther it is from the other axis, so the middle of each edge stays put and corners stretch.
    vec2 centered = destCoord() / outputSize - 0.5;
    vec2 bent = centered * (1.0 + vec2(0.17, 0.22) * centered.yx * centered.yx);

    // Picture tube with rounded corners, fading to black over about one device pixel.
    float radius = 0.035;
    vec2 corner = abs(bent) - (0.5 - radius);
    float distanceOutside = length(max(corner, 0.0)) + min(max(corner.x, corner.y), 0.0) - radius;
    float edgeWidth = 1.5 / min(outputSize.x, outputSize.y);
    float screen = 1.0 - smoothstep(-edgeWidth, 0.0, distanceOutside);

    vec2 position = (bent + 0.5) * sourceSize;
    vec2 scale = sourceSize / outputSize;

    // Slightly smeared horizontally, like an analog video signal.
    vec3 color = 0.4 * readColor(source, position, sourceSize) + 0.3 * readColor(source, position + vec2(-0.5, 0.0), sourceSize) + 0.3 * readColor(source, position + vec2(0.5, 0.0), sourceSize);

    // Light from nearby pixels spreading through the glass.
    vec3 glow = 0.25 * (readColor(source, position + vec2(-1.75, 0.0), sourceSize) + readColor(source, position + vec2(1.75, 0.0), sourceSize) +
                        readColor(source, position + vec2(0.0, -1.25), sourceSize) + readColor(source, position + vec2(0.0, 1.25), sourceSize));

    // Scanlines never go fully dark on a TV. Interlaced (high resolution) frames get one scanline for every two rows.
    float rowsPerLine = sourceSize.y > 300.0 ? 2.0 : 1.0;
    float brightness = max(max(color.r, color.g), color.b);
    color *= mix(0.35, 1.0, scanlines(position.y / rowsPerLine, scale.y / rowsPerLine, brightness));

    // Slot mask: red, green, and blue phosphor stripes broken into slots, with neighboring triads staggered by half a slot.
    vec2 pixel = floor(destCoord());
    float stripe = mod(pixel.x, 3.0);
    float triad = floor(pixel.x / 3.0);
    float slotRow = mod(pixel.y + 2.0 * mod(triad, 2.0), 4.0);
    vec3 phosphor = vec3(stripe == 0.0 ? 1.0 : 0.72, stripe == 1.0 ? 1.0 : 0.72, stripe == 2.0 ? 1.0 : 0.72);
    color *= phosphor * (slotRow == 0.0 ? 0.7 : 1.0);

    color = color * 1.6 + glow * 0.22;

    // Corners of the tube are dimmer than the middle.
    float vignette = mix(1.0, 0.55, smoothstep(0.2, 0.72, length(centered * vec2(1.0, 0.9))));
    color *= vignette;

    return vec4(clamp(color, 0.0, 1.0) * screen, 1.0);
}
